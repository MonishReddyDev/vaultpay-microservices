# Database configuration (Matches Docker Compose)
DATABASE_URL="postgresql://wallet_user:wallet_pass@postgres:5432/digital_wallet_ms?schema=public"

# RabbitMQ configuration
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672"

# Redis configuration
REDIS_URL="redis://redis:6379"

# JWT Secrets
JWT_SECRET="your_super_secret_jwt_key_here_for_production"

# Service URLs (Internal Docker network routing)
AUTH_SERVICE_URL="http://auth-service:3001"
WALLET_SERVICE_URL="http://wallet-service:3002"
TRANSACTION_SERVICE_URL="http://transaction-service:3003"
PAYMENT_SERVICE_URL="http://payment-service:3004"
